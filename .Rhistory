# boxcox plots for numerics to evaluate lambda power ladder changes
lambda_seq <- seq(-2, 2, by = 0.1)
plot(NULL,
xlim = c(-2, 2),
ylim = c(-50, 10), # may need adjustment
xlab = expression(lambda),
ylab = "Log-Likelihood",
main = "Box-Cox Profiles")
cols <- rainbow(ncol(housingNumeric))
for(i in seq_along(housingNumeric)) {
x <- housingNumeric[[i]]
# Box-Cox requires positive values
if(any(x <= 0, na.rm = TRUE)) next
fit <- lm(x ~ 1)
bc <- boxcox(
fit,
lambda = lambda_seq,
plotit = FALSE
)
lines(
bc$x,
bc$y,
col = cols[i],
lwd = 2
)
}
legend("bottomleft",
legend = names(housingNumeric),
col = cols,
lty = 1,
cex = 0.5)
# boxcox plots for numerics to evaluate lambda power ladder changes
results <- data.frame()
for(v in names(housingNumeric)) {
x <- housingNumeric[[v]]
if(any(x <= 0, na.rm = TRUE)) next
bc <- boxcox(
lm(x ~ 1),
lambda = seq(-2, 2, 0.1),
plotit = FALSE
)
results <- rbind(
results,
data.frame(
Variable = v,
Lambda = bc$x,
LogLik = bc$y
)
)
}
ggplot(results,
aes(Lambda, LogLik)) +
geom_line() +
facet_wrap(~ Variable,
scales = "free_y")
