### (j) Create the 2nd part of the DQR for the factor data

## new functions necessary
# identication of 1st 2nd least common modes
getmodes <- function(v,type=1) {
  tbl <- table(v)
  m1<-which.max(tbl)
  if (type==1) {
    return (names(m1)) #1st mode
  }
  else if (type==2) {
    return (names(which.max(tbl[-m1]))) #2nd mode
  }
  else if (type==-1) {
    return (names(which.min(tbl))) #least common mode
  }
  else {
    stop("Invalid type selected")
  }
}

# Frequencies of 1st 2nd leas common modes.

getmodesFrq <- function(v,type=1) {
  tbl <- table(v)
  m1<-which.max(tbl)
  if (type==1) {
    return (max(tbl)) #1st mode freq
  }
  else if (type==2) {
    return (max(tbl[-m1])) #2nd mode freq
  }
  else if (type==-1) {
    return (min(tbl)) #least common freq
  }
  else {
    stop("Invalid type selected")
  }
}

#create new function for factor summary

myFactorSummary <- function(x) {
  c(length(x), n_distinct(x), sum(is.na(x)), 
    getmodes(x,type=1),getmodesFrq(x,type=1),
    getmodes(x,type=2),getmodesFrq(x,type=2),
    getmodes(x,type=-1),getmodesFrq(x,type=-1))
}

#Run the function across all factors
factorSummary <- housingFactor |> 
  reframe(across(everything(),myFactorSummary))
factorSummary
